{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "public": true,
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/guides/how-to-read/", "permanent": true },
    { "source": "/about", "destination": "https://algebra-mcx.github.io/", "permanent": true },
    { "source": "/about/", "destination": "https://algebra-mcx.github.io/", "permanent": true }
  ]
}
