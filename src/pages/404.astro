---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
---
<BaseLayout title="Page not found — Chenxi Ma">
  <section class="not-found page-intro shell">
    <p class="eyebrow">404</p>
    <h1><Localized en="Page not found" zh="页面未找到" /></h1>
    <p><Localized en="This page may have moved." zh="这个页面可能已迁移。" /></p>
    <p><a class="text-link" href="/"><Localized en="Back to the blog ↗" zh="返回博客 ↗" /></a></p>
  </section>
</BaseLayout>
