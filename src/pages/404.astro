---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Geometry from '@/components/Geometry.astro';
---
<BaseLayout title="Not found — MCX" description="The requested page could not be found.">
  <section class="not-found shell"><div><p class="eyebrow">404 · Coordinate unresolved</p><h1>Nothing at this address.</h1><p>The page may have moved, or the path may be incomplete.</p><a class="text-link" href="/">Return home <span class="arrow">→</span></a></div><Geometry variant="article" /></section>
</BaseLayout>
<style>
  .not-found { min-height: 65vh; display: grid; grid-template-columns: 1fr .7fr; align-items: center; gap: 3rem; }
  h1 { margin: 0; font: 460 clamp(3.5rem, 8vw, 7rem)/.95 var(--serif); letter-spacing: -.055em; }
  p:not(.eyebrow) { color: var(--ink-soft); }
  .not-found :global(.geometry) { height: 360px; opacity: .7; }
  @media (max-width: 700px) { .not-found { grid-template-columns: 1fr; }.not-found :global(.geometry) { height: 180px; } }
</style>
