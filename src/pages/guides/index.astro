---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import EntryCard from '@/components/EntryCard.astro';
import { domains, guideSections } from '@/data/library';
const entries = await getCollection('guides', ({ data }) => !data.draft);
---
<BaseLayout title="Guides — Chenxi Ma" description="Core concepts, minimal experiments, practical methods and reading paths across algorithms, data and infrastructure.">
  <header class="page-intro shell"><p class="eyebrow"><Localized en="Understand. Run. Explore." zh="理解、动手、深入。" /></p><h1><Localized en="Guides" zh="指南" /></h1><p><Localized en="Small starting points and reusable methods across algorithms, data and infrastructure." zh="从算法、数据和基础设施中的小问题入手，建立可复用的理解与方法。" /></p></header>
  <section class="library-section shell" data-filter-list>
    <nav class="section-tabs" aria-label="Guide categories"><a href="/guides/" aria-current="page"><Localized en="All guides" zh="全部指南" /></a>{guideSections.map(s => <a href={`/guides/sections/${s.id}/`}><Localized en={s.en} zh={s.zh} /></a>)}</nav>
    <div class="filter-bar"><label><span><Localized en="Domain" zh="领域" /></span><select data-filter="domain"><option value="all">All / 全部</option>{domains.map(d => <option value={d.id}>{d.en} / {d.zh}</option>)}</select></label></div>
    {guideSections.map(s => <section class="guide-group" data-filter-group><div class="section-heading"><div><h2><a href={`/guides/sections/${s.id}/`}><Localized en={s.en} zh={s.zh} /></a></h2><p class="section-description"><Localized en={s.description} zh={s.descriptionZh} /></p></div></div><div class="guide-cards">{entries.filter(e => e.data.category === s.id).map(e => <div class="reading-glass guide-card" data-filter-row data-domain={e.data.domains.join('|')}><EntryCard href={`/guides/${e.id}/`} title={e.data.title} titleZh={e.data.titleZh} description={e.data.description} descriptionZh={e.data.descriptionZh} label={e.data.domains.map(id => domains.find(d => d.id === id)!.en).join(' · ')} labelZh={e.data.domains.map(id => domains.find(d => d.id === id)!.zh).join(' · ')} /></div>)}</div></section>)}
    <p class="empty-state" data-filter-empty hidden><Localized en="No guides match this domain yet." zh="这个领域暂时没有指南。" /></p>
    <a class="text-link" href="/guides/sections/playbooks/#debugging-map"><Localized en="Find an investigation by symptom →" zh="按症状查找排障记录 →" /></a>
  </section>
</BaseLayout>
<script>import '@/scripts/filters';</script>
