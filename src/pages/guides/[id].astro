---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import ReadingGuideLayout from '@/layouts/ReadingGuideLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('guides', ({ data }) => !data.draft);
  const translations = await getCollection('guidesZh');
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry, translation: translations.find(t => t.data.source === entry.id) } }));
}
const { entry, translation } = Astro.props;
const { Content, headings } = await render(entry);
const translated = translation ? await render(translation) : null;
const ContentZh = translated?.Content;
const Layout = entry.id === 'how-to-read' ? ReadingGuideLayout : ArticleLayout;
---
<Layout entry={entry} headings={headings} headingsZh={translated?.headings}>
  <div data-lang="en"><Content /></div>{ContentZh && <div data-lang="zh"><ContentZh /></div>}
</Layout>
