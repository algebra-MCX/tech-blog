---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import QuickstartIndex from '@/components/QuickstartIndex.astro';
import { guideSections } from '@/data/library';
export function getStaticPaths() { return guideSections.filter(section => section.id === 'quickstarts').map(section => ({ params: { section: section.id }, props: { section } })); }
const { section } = Astro.props;
const entries = (await getCollection('guides', ({ data }) => !data.draft)).filter(e => e.data.category === section.id);
---
<BaseLayout title={`${section.en} — Guides — Chenxi Ma`} description={section.description}>
  <QuickstartIndex entries={entries} />
</BaseLayout>
