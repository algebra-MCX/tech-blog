---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import { site } from '@/data/site';
---
<BaseLayout title="Chenxi Ma — LLM Systems Research" description="Independent research and engineering in distributed MoE inference, GPU runtime optimization, and reproducible LLM systems.">
  <section class="shell research-hero">
    <p class="eyebrow"><Localized en="Independent research · Open source" zh="独立研究 · 开源工程" /></p>
    <h1>Chenxi Ma</h1>
    <p class="research-lead">LLM Systems · GPU Performance · Distributed MoE</p>
    <p class="research-intro"><Localized en="I investigate real bottlenecks in LLM inference and build readable, reproducible systems. My focus is execution efficiency, distributed communication and understanding why an optimization does—or does not—help." zh="研究大模型推理的真实瓶颈，构建可理解、可复现的系统。重点关注执行效率、分布式通信，以及为什么某项优化真正有效或无效。" /></p>
    <div class="research-actions">
      <a class="research-action" href="/projects/"><Localized en="Explore projects →" zh="查看项目 →" /></a>
      <a class="research-action" href="/writing/"><Localized en="Read research →" zh="阅读研究 →" /></a>
      <a class="research-action" href={site.learning}><Localized en="Learning hub ↗" zh="学习资料 ↗" /></a>
    </div>
  </section>
  <section class="shell research-home-section">
    <div class="research-home-heading"><p class="eyebrow"><Localized en="Featured engineering work" zh="精选工程研究" /></p><h2><Localized en="Evidence first." zh="以证据为先。" /></h2></div>
    <div class="research-home-grid">
      <article class="reading-glass research-home-feature">
        <p class="eyebrow">GPU Performance · DeepInfer</p>
        <h3><a href="/writing/mini-deepinfer-prefill/"><Localized en="From 3% to 11.9% of DeepInfer performance" zh="从官方性能的 3% 到 11.9%" /></a></h3>
        <p><Localized en="Three kernel improvements on a real model, complete with paired measurements, correctness checks and an honest accounting of the remaining gap. Results compare stages of mini-DeepInfer, not a faster-than-official engine." zh="在真实模型上逐步优化三个 Kernel，保留配对实验、正确性检查及剩余差距。提升来自 mini-DeepInfer 自身，而非超越官方引擎。" /></p>
        <a class="text-link" href="/writing/mini-deepinfer-prefill/"><Localized en="Read the analysis →" zh="阅读完整分析 →" /></a>
      </article>
      <article class="reading-glass research-home-feature">
        <p class="eyebrow">MoE Runtime · Experimental</p>
        <h3><a href="/projects/moeflow/">MoEFlow</a></h3>
        <p><Localized en="A reproducible investigation of routed execution, communication and CUDA Graph constraints. Local improvements are separated from still-unproven serving-wide gains." zh="关于 MoE 路由执行、通信和 CUDA Graph 约束的可复现实验。明确区分局部收益和尚未证明的服务端到端收益。" /></p>
        <a class="text-link" href="/projects/moeflow/"><Localized en="Open project →" zh="进入项目 →" /></a>
      </article>
      <article class="reading-glass research-home-feature">
        <p class="eyebrow">Open source · Production systems</p>
        <h3><a href="/projects/"><Localized en="vLLM, DeepInfer & workload research" zh="vLLM、DeepInfer 与负载研究" /></a></h3>
        <p><Localized en="Contributions and proposals around scheduling, distributed MoE execution, correctness and realistic workload replay, with upstream review status clearly distinguished." zh="围绕调度、分布式 MoE、正确性和真实负载重放的贡献与提案，明确标注上游审阅状态。" /></p>
        <a class="text-link" href="/projects/"><Localized en="View contributions →" zh="查看贡献 →" /></a>
      </article>
    </div>
  </section>
  <section class="shell research-home-section research-home-links">
    <h2><Localized en="Read, reproduce, discuss." zh="阅读、复现、交流。" /></h2>
    <p><Localized en="The research archive contains detailed experiments and failures. The separate learning hub contains curated reading paths and minimal examples, in the same bilingual design." zh="研究归档收录实验、结论和失败记录；独立学习站提供双语精选资料、学习路线与最小示例。" /></p>
    <div class="research-actions"><a class="text-link" href="/writing/"><Localized en="Research archive →" zh="研究归档 →" /></a><a class="text-link" href={site.learning}><Localized en="Learning hub ↗" zh="学习资料 ↗" /></a><a class="text-link" href={site.github}>GitHub ↗</a></div>
  </section>
</BaseLayout>
<style>
  .research-hero{padding:clamp(68px,10vw,118px) 0 68px;max-width:960px}
  .research-hero h1{font-size:clamp(52px,8vw,84px);line-height:1.1;margin:8px 0 18px;letter-spacing:-.05em}
  .research-lead{font-size:clamp(22px,3vw,31px);font-weight:650;margin:0;color:var(--ink)}
  .research-intro{max-width:760px;font-size:20px;line-height:1.8;color:var(--ink-soft)}
  .research-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:28px}
  .research-action{display:inline-flex;padding:12px 18px;background:var(--glass-fill);border:1px solid var(--glass-border);border-radius:13px;font-size:16px}
  .research-action:hover{background:var(--lens-fill)}
  .research-home-section{padding-block:36px 55px}
  .research-home-heading h2{margin:0 0 22px}
  .research-home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .research-home-feature{padding:30px;min-width:0}
  .research-home-feature:first-child{grid-column:1 / -1}
  .research-home-feature h3{margin:0 0 12px;font-size:24px}
  .research-home-feature p:not(.eyebrow){font-size:16px;line-height:1.85;color:var(--ink-soft)}
  .research-home-feature a.text-link{font-size:15px}
  .research-home-links{border-top:1px solid var(--line)}
  .research-home-links h2{margin:0 0 10px}
  .research-home-links p{max-width:750px;color:var(--ink-soft);font-size:17px}
  @media(max-width:700px){.research-home-grid{grid-template-columns:1fr}.research-home-feature:first-child{grid-column:auto}.research-home-feature{padding:22px}.research-hero{padding-top:60px}}
</style>
