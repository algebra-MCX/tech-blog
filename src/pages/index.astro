---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import {site} from '@/data/site';
import {deepinferSource, moeflowSource} from '@/data/evidence';
import '@/styles/portfolio.css';
const moeFiles = moeflowSource.replace('/tree/', '/blob/');

---
<BaseLayout title="Chenxi Ma — Inference Systems, Measured" description="Selected work in LLM inference: original bottleneck analysis, reproducible experiments and upstream engineering, with baselines and open questions.">
  <header class="shell portfolio-intro">
    <p class="eyebrow"><Localized en="Chenxi Ma · AI systems research & engineering" zh="马晨熙 · AI 系统研究与工程" /></p>
    <h1><Localized en="LLM inference, from implementation to evidence" zh="从实现与实验出发，研究大模型推理" /></h1>
    <p><Localized en="I study how scheduling, data movement and kernels shape LLM inference. These are the implementations, measurements and unresolved questions behind my work." zh="我研究调度、数据搬运与 kernel 如何影响大模型推理。这里精选我的实现、测量与尚未解决的问题，供你阅读、核验与讨论。" /></p>
    <div class="portfolio-links"><a href="/guides/how-to-read/"><Localized en="A first reading path" zh="首次访问阅读指南" /></a><a href="/projects/"><Localized en="All projects & contributions" zh="全部项目与贡献" /></a></div>
  </header>
  <section class="shell selected-work" aria-labelledby="selected-title">
    <div class="portfolio-section-title"><h2 id="selected-title"><Localized en="Selected work" zh="代表作" /></h2></div>
    <article class="reading-glass lead-study">
      <div class="study-narrative">
        <p class="eyebrow">DeepInfer-Lab <span class="previous-name"><Localized en="formerly mini-DeepInfer" zh="原 mini-DeepInfer" /></span></p>
        <h3><a href="/writing/mini-deepinfer-prefill/"><Localized en="Three kernel changes. A moving bottleneck." zh="三个 kernel 改动，瓶颈如何迁移？" /></a></h3>
        <p><Localized en="I profiled and changed sparse attention, indexer scoring and expert combine, checking correctness after each round. Which cost took over after attention stopped dominating?" zh="我用 profile 定位问题，依次改动稀疏注意力、indexer 打分和专家合并，每轮核对正确性。注意力不再主导之后，什么开销接了上来？" /></p>
        <div class="study-links"><a href="/writing/mini-deepinfer-prefill/"><Localized en="Read the investigation" zh="阅读完整分析" /></a><a href={deepinferSource}><Localized en="Source snapshot" zh="源码快照" /></a><a href={deepinferSource + '/docs/perf-reports/'}><Localized en="Per-change reports" zh="逐项实验报告" /></a></div>
      </div>
      <aside class="study-measurement"><p class="eyebrow"><Localized en="Measured prefill throughput" zh="Prefill 吞吐实测" /></p><div class="study-number">1,084.8 → 4,315.9</div><p class="evidence-caption"><Localized en="Input tok/s/GPU, own initial baseline to final round. DeepSeek-V4.1-Flash on 4 × B200, 4,096 new tokens/rank/step. One run per round, prefill only. The official reference reaches 36,170.9 under the reported comparison." zh="输入 tok/s/GPU，自身初始基线到最终阶段。DeepSeek-V4.1-Flash，4 × B200，每步每卡 4,096 个新 token。每阶段一组运行，仅测 prefill。同组参照中官方为 36,170.9。" /></p></aside>
    </article>
    <div class="secondary-studies">
      <article class="reading-glass compact-study">
        <p class="eyebrow">MoEFlow · <Localized en="Measured layer experiment" zh="层级实验" /></p>
        <h3><a href="/writing/moeflow-fixed-capacity/"><Localized en="When does fusion pay for fixed capacity?" zh="融合能抵消固定容量的代价吗？" /></a></h3>
        <p><Localized en="I fuse dispatch pack, expert preparation and combine into a graph-capturable EP path with two all-to-alls. The question is whether less orchestration offsets padded work." zh="融合 dispatch pack、专家输入准备与 combine，构建只需两次 all-to-all、可捕获为图的 EP 路径，检验减少调度开销能否抵消填充工作。" /></p>
        <div class="study-number">249.7 <span>→</span> 144.2 <small>µs</small></div>
        <p class="evidence-caption"><Localized en="Own unfused Torch Ring baseline → fused path. Routed layer, 4 × B200, EP4, BF16, T=1/rank, uniform routing; graph replay, 20 interleaved A/B repetitions, slowest rank/sample." zh="自身未融合 Torch Ring 基线 → 融合路径。路由层，4 × B200、EP4、BF16、每 rank 1 token、均匀路由；图重放，20 次交替 A/B，每样本取最慢 rank。" /></p>
        <p class="study-limit"><Localized en="Native vLLM is still 1.4–4.7% faster across the separately measured sizes. Stable serving speedup remains unproven; raw paired JSON is not available in the current public snapshot." zh="另一组测量中原生 vLLM 仍快 1.4–4.7%。尚未证明稳定的服务级收益；当前公开快照未附原始配对 JSON。" /></p>
        <div class="study-links"><a href="/writing/moeflow-fixed-capacity/"><Localized en="Analysis & limits" zh="分析与边界" /></a><a href={moeFiles + '/README.md#performance'}><Localized en="Recorded measurements" zh="测量记录" /></a><a href={moeFiles + '/scripts/paired_total_fusion.sbatch'}><Localized en="Experiment script" zh="实验脚本" /></a></div>
      </article>
      <article class="reading-glass compact-study">
        <p class="eyebrow">vLLM · <Localized en="Merged engineering" zh="已合并工程贡献" /></p>
        <h3><a href="/writing/vllm-dbo-correctness/"><Localized en="Two microbatches, one overwritten route buffer." zh="两个微批，谁覆盖了路由记录？" /></a></h3>
        <p><Localized en="With DBO enabled, each microbatch wrote from row zero. I reproduced the corruption and fixed the mapping to parent token rows; a collaborator refactored the fix and added coverage." zh="启用 DBO 时，每个微批都从第 0 行写路由。我复现并修复了父批次 token 行的映射，协作者参与重构并补充测试。" /></p>
        <div class="study-number">#63372 <small>· <Localized en="merged" zh="已合并" /></small></div>
        <p class="evidence-caption"><Localized en="DeepSeek-V2-Lite, 2 × H200, DP2/EP, NIXL, eager; 32 requests. Route agreement: 0% before, 89.4% after; DBO-off rerun noise: 88–91%. A correctness comparison, not a speed benchmark." zh="DeepSeek-V2-Lite，2 × H200、DP2/EP、NIXL、eager，32 个请求。路由一致率：修复前 0%，修复后 89.4%；关闭 DBO 重跑为 88–91%。这是正确性对比，不是性能基准。" /></p>
        <p class="study-limit"><Localized en="The patch restores row ownership. It does not establish exact routing equality across nondeterministic runs. A separate merged fix preserves the first recorded DBO failure." zh="改动恢复了每行的归属，不证明不同非确定性运行的路由严格相等。另一个已合并修复保留最先记录的 DBO 异常。" /></p>
        <div class="study-links"><a href="/writing/vllm-dbo-correctness/"><Localized en="Follow the bug" zh="沿着问题看修复" /></a><a href="https://github.com/vllm-project/vllm/pull/63372"><Localized en="Upstream PR & tests" zh="上游 PR 与测试" /></a><a href="https://github.com/vllm-project/vllm/pull/63476">#63476</a></div>
      </article>
    </div>
  </section>
  <section class="shell portfolio-open">
    <div>
      <h2><Localized en="More engineering work" zh="其他工程工作" /></h2>
      <p><a class="text-link" href="/writing/vllm-decode-staging/"><Localized en="Decode staging for uneven DP loads" zh="不均衡 DP 负载的 decode staging" /></a> · <Localized en="Proposal" zh="工程提案" /></p>
      <p><a class="text-link" href="https://github.com/uw-syfi/TraceLab/pull/1"><Localized en="TraceLab session-aware replay runner" zh="TraceLab 会话级负载重放器" /></a> · <Localized en="Merged implementation" zh="已合并实现" /></p>
    </div>
    <aside class="reading-glass">
      <h3><Localized en="Discuss the work" zh="交流与合作" /></h3>
      <p><Localized en="I’m interested in LLM inference research and engineering roles. If you have a trace, reproduction result or counterexample, I’d like to hear from you." zh="我关注大模型推理方向的研究与工程机会。欢迎带着 trace、复现结果或反例来交流。" /></p>
      <div class="study-links"><a href={'mailto:' + site.email}><Localized en="Email me" zh="邮件联系" /></a><a href={site.homepage} data-cross-site><Localized en="Personal homepage" zh="个人主页" /></a></div>
    </aside>
  </section>
</BaseLayout>
