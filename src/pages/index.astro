---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import { site } from '@/data/site';
const stages = [
  { label: 'Baseline', zh: '初始实现', value: 1085 },
  { label: 'Sparse attention', zh: '稀疏注意力', value: 2572 },
  { label: 'Fused indexer', zh: '融合 Indexer', value: 3373 },
  { label: 'Local-row combine', zh: '本地行合并', value: 4316 }
];
const selected = [
  { id: 'mini-deepinfer-runtime', kind: 'Runtime design', kindZh: '运行时设计', title: 'Follow a request through the runtime', titleZh: '沿着一条请求，读懂运行时', description: 'Scheduling, KV lifetime, preemption and distributed execution in a readable PyTorch implementation.', descriptionZh: '通过可阅读的 PyTorch 实现，理解调度、KV 生命周期、抢占与分布式执行。' },
  { id: 'mini-deepinfer-design', kind: 'Design decisions', kindZh: '设计取舍', title: 'Why the engine is built this way', titleZh: '为什么引擎要这样设计', description: 'The constraints and tradeoffs behind a minimal implementation of a real inference system.', descriptionZh: '真实推理系统的最小实现：设计背后的约束、选择与取舍。' }
];
const questions = [
  { href: '/writing/communication-overlap/', title: 'When does overlap stop helping?', titleZh: '通信重叠何时不再带来收益？', description: 'Critical paths, resource contention and the end-to-end objective.', descriptionZh: '关键路径、资源争用与端到端目标。' },
  { href: '/projects/moeflow/', title: 'When do layer gains survive the full runtime?', titleZh: '层级加速如何转化为完整运行时的收益？', description: 'Routing imbalance, communication and CUDA Graph constraints.', descriptionZh: '路由不均衡、通信与 CUDA Graph 约束。' },
  { href: '/projects/tracelab/', title: 'What should a serving benchmark preserve?', titleZh: '服务基准应保留哪些真实负载特征？', description: 'Request order, session dependencies and tool waits.', descriptionZh: '请求顺序、会话依赖与工具等待。' }
];
---
<BaseLayout title="Chenxi Ma — Building & Understanding AI Systems" description="Original engineering, experiments and research questions in LLM inference, GPU performance and distributed systems. Code, measurements and design decisions by Chenxi Ma.">
  <section class="shell research-hero">
    <p class="eyebrow">Chenxi Ma · <Localized en="Research & engineering" zh="研究与工程" /></p>
    <h1><Localized en="Building & understanding AI systems." zh="构建 AI 系统，理解其运行本质。" /></h1>
    <p class="research-intro"><Localized en="I build inference runtimes and investigate what makes them fast, correct and useful. Here I share the questions, implementations and experiments behind my work." zh="我构建推理运行时，研究如何让它们更快、正确且有用。在这里分享工作中的问题、实现、实验，以及由此形成的技术判断。" /></p>
    <p class="focus-line">LLM Inference <span> / </span> GPU Performance <span> / </span> Distributed Systems</p>
    <div class="research-actions"><a class="primary-action" href="#selected-work"><Localized en="Read selected work" zh="阅读精选研究" /></a><a class="text-link" href="/projects/"><Localized en="Explore projects" zh="探索项目" /></a><a class="text-link" href="/about-this-blog/"><Localized en="About this blog" zh="关于这个博客" /></a></div>
  </section>

  <section class="shell home-section" id="selected-work" aria-labelledby="selected-title">
    <div class="section-top"><div><p class="eyebrow"><Localized en="Selected work" zh="精选研究与工程" /></p><h2 id="selected-title"><Localized en="From a bottleneck to an explanation." zh="从真实瓶颈，走向可验证的解释。" /></h2></div><a class="text-link" href="/writing/"><Localized en="All research" zh="全部研究" /></a></div>
    <article class="reading-glass flagship">
      <div class="flagship-copy"><p class="eyebrow"><Localized en="Performance report · 4 × B200" zh="性能报告 · 4 × B200" /></p><h3><a href="/writing/mini-deepinfer-prefill/"><Localized en="Three kernels. A 4× improvement. A gap still worth understanding." zh="三个 Kernel，约 4 倍提升，以及仍值得追问的差距。" /></a></h3><p><Localized en="mini-DeepInfer went from 1,085 to 4,316 input tok/s/GPU. Profiles explain each improvement—and why the official reference remains 8.4× faster." zh="mini-DeepInfer 从 1,085 提升至 4,316 输入 tok/s/GPU。通过 Profile 解释每一步收益，以及官方参考实现为什么仍快 8.4 倍。" /></p><a class="text-link" href="/writing/mini-deepinfer-prefill/"><Localized en="Read the experiment" zh="阅读实验分析" /></a></div>
      <figure class="benchmark"><figcaption><Localized en="Prefill throughput · input tok/s/GPU" zh="Prefill 吞吐 · 输入 tok/s/GPU" /></figcaption><div class="benchmark-bars">{stages.map(stage => <div class="benchmark-row"><div class="benchmark-label"><span><Localized en={stage.label} zh={stage.zh} /></span><strong>{stage.value.toLocaleString('en-US')}</strong></div><div class="benchmark-track"><div class="benchmark-bar" style={`width:${stage.value / 4500 * 100}%`}></div></div></div>)}</div><p class="benchmark-scope"><Localized en="One paired run per stage · Real-model prefill · Final result: 11.9% of the official reference. Decode graphs off; KV budgets not matched." zh="各阶段单轮配对测量 · 真实模型 Prefill · 最终达到官方参考的 11.9%。未开启 Decode Graph；KV 预算未对齐。" /></p></figure>
    </article>
    <div class="selected-grid">{selected.map(item => <article class="selected-article"><p class="eyebrow"><Localized en={item.kind} zh={item.kindZh} /></p><h3><a href={`/writing/${item.id}/`}><Localized en={item.title} zh={item.titleZh} /></a></h3><p><Localized en={item.description} zh={item.descriptionZh} /></p></article>)}</div>
  </section>

  <section class="shell home-section" aria-labelledby="questions-title"><div class="section-top"><div><p class="eyebrow"><Localized en="Open questions" zh="开放问题" /></p><h2 id="questions-title"><Localized en="What I want to understand next." zh="接下来，想弄清楚什么。" /></h2></div></div><p class="section-intro"><Localized en="Questions guide the work below. The linked outlines and project records show what is established and what still needs testing." zh="这些问题指引后续工作。关联的提纲与项目记录会交代已有证据，以及仍需验证的部分。" /></p><div class="question-list">{questions.map(q => <article><h3><a href={q.href}><Localized en={q.title} zh={q.titleZh} /></a></h3><p><Localized en={q.description} zh={q.descriptionZh} /></p></article>)}</div></section>

  <section class="shell home-section" aria-labelledby="evidence-title"><div class="section-top"><div><p class="eyebrow"><Localized en="Code & evidence" zh="代码与证据" /></p><h2 id="evidence-title"><Localized en="Inspect the work behind the writing." zh="沿着文章，检验背后的工作。" /></h2></div></div><div class="evidence-grid"><article><h3>mini-DeepInfer</h3><p><Localized en="Readable runtime, kernel reports, raw profiles and reproduction commands." zh="可阅读的运行时、内核报告、原始 Profile 与复现命令。" /></p><a class="text-link" href="https://github.com/algebra-MCX/mini-DeepInfer/tree/main/docs/benchmarks/profile-2026-10-22/"><Localized en="Experiment materials" zh="实验材料" /></a></article><article><h3>MoEFlow</h3><p><Localized en="Experimental execution backend, paired baselines and end-to-end order controls." zh="实验执行后端、配对基线与端到端测量顺序控制。" /></p><a class="text-link" href="/projects/moeflow/"><Localized en="Design & validation" zh="设计与验证" /></a></article><article><h3><Localized en="Open-source contributions" zh="开源贡献" /></h3><p><Localized en="Implementation and review records across vLLM, DeepInfer and TraceLab." zh="vLLM、DeepInfer 与 TraceLab 的实现及审阅记录。" /></p><a class="text-link" href="/projects/"><Localized en="Projects & upstream records" zh="项目与上游记录" /></a></article></div></section>

  <section class="shell home-section home-closing"><div><p class="eyebrow"><Localized en="Learn by building" zh="在构建中学习" /></p><h2><Localized en="A short path in. Room to go deeper." zh="用短路径入门，向深处探索。" /></h2><p><Localized en="Start with a minimal implementation, change one variable, then connect the result to a real system. The learning hub keeps these entry paths together." zh="从最小实现开始，改变一个变量，再把实验现象连接到真实系统。学习入口保留这些路线与实践方法。" /></p><a class="text-link" href={site.learning}><Localized en="Open the learning hub" zh="进入学习资料" /></a></div><div class="contact-block"><h3><Localized en="Have a result to discuss?" zh="有值得讨论的结果？" /></h3><p><Localized en="Questions, reproductions and corrections are welcome. Share the setup, observation or technical disagreement." zh="欢迎交流问题、复现与修正。带上具体配置、观察，或你不同意的技术判断。" /></p><a class="text-link" href={`mailto:${site.email}`}><Localized en="Get in touch" zh="联系我" /></a><a class="text-link" href={site.github}>GitHub</a></div></section>
</BaseLayout>
<style>
.research-hero{padding:clamp(64px,9vw,104px) 0 62px}.research-hero h1{max-width:850px;font-size:clamp(40px,6.1vw,64px);line-height:1.13;letter-spacing:-.045em;margin:16px 0 24px}.research-intro{max-width:735px;font-size:20px;line-height:1.8;color:var(--ink-soft)}.focus-line{font-family:var(--mono);font-size:14px;color:var(--ink-faint);margin-top:26px}.focus-line span{padding:0 8px;color:var(--line-strong)}.research-actions{display:flex;gap:26px;align-items:center;flex-wrap:wrap;margin-top:30px;font-size:16px}.primary-action{padding:11px 19px;background:var(--glass-fill);color:var(--ink);border:1px solid var(--glass-border);border-radius:13px;font-weight:650}.primary-action:hover{color:var(--ink);background:var(--lens-fill)}.home-section{padding:45px 0;border-top:1px solid var(--line)}.section-top{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:26px}.section-top h2{margin:0;font-size:clamp(25px,3.5vw,32px)}.section-top>.text-link{white-space:nowrap;font-size:15px}.flagship{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;padding:32px}.flagship h3{font-size:28px;line-height:1.4;margin:10px 0 18px}.flagship-copy>p:not(.eyebrow){font-size:16px;color:var(--ink-soft)}.flagship .text-link{font-size:16px}.benchmark{margin:0;align-self:center;min-width:0}.benchmark figcaption{font-size:14px;color:var(--ink-faint);margin-bottom:20px}.benchmark-row{margin-bottom:16px}.benchmark-label{display:flex;justify-content:space-between;gap:14px;font-size:14px;line-height:1.5;margin-bottom:7px}.benchmark-label strong{font-family:var(--mono);font-size:15px}.benchmark-track{height:8px;background:var(--accent-soft);border-radius:3px;overflow:hidden}.benchmark-bar{height:100%;background:#7da9cd;border-radius:3px}.benchmark-row:last-child .benchmark-bar{background:#b8e0e3}.benchmark-scope{font-size:14px;line-height:1.65;color:var(--ink-faint);margin:20px 0 0}.selected-grid{display:grid;grid-template-columns:1fr 1fr;gap:38px;margin-top:28px}.selected-article{padding:16px 0}.selected-article h3{font-size:23px;margin:10px 0}.selected-article>p:last-child,.section-intro,.question-list p,.evidence-grid p,.home-closing p:not(.eyebrow){font-size:16px;color:var(--ink-soft);line-height:1.8}.section-intro{max-width:730px;margin-bottom:28px}.question-list article{display:grid;grid-template-columns:1.15fr 1fr;gap:32px;padding:20px 0;border-bottom:1px solid var(--line-soft)}.question-list article:last-child{border-bottom:0}.question-list h3{font-size:21px;margin:0}.question-list p{margin:0}.evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.evidence-grid h3{font-size:21px;margin:0 0 12px}.evidence-grid .text-link,.home-closing .text-link{font-size:15px}.home-closing{display:grid;grid-template-columns:1.4fr 1fr;gap:64px;padding-bottom:65px}.home-closing h2{font-size:27px;margin:10px 0}.contact-block{border-left:1px solid var(--line);padding-left:30px}.contact-block h3{font-size:21px}.contact-block .text-link+.text-link{margin-left:24px}
@media(max-width:700px){.flagship{grid-template-columns:1fr;gap:30px;padding:24px}.selected-grid,.evidence-grid,.home-closing{grid-template-columns:1fr;gap:24px}.question-list article{grid-template-columns:1fr;gap:8px}.section-top{align-items:start;flex-direction:column;gap:12px}.focus-line{font-size:14px;line-height:2}.focus-line span{padding:0 2px}.research-actions{gap:18px}.contact-block{border-left:0;border-top:1px solid var(--line);padding:20px 0 0}.home-section{padding-block:34px}.flagship h3{font-size:25px}}
</style>
