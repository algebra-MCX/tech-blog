---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  const translations = await getCollection('writingZh');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, translation: translations.find((item) => item.data.source === entry.id) }
  }));
}
const { entry, translation } = Astro.props;
const { Content, headings } = await render(entry);
const translated = translation ? await render(translation) : null;
const ContentZh = translated?.Content;
---
<ArticleLayout entry={entry} headings={headings}>
  <div data-lang="en"><Content /></div>
  {ContentZh && <div data-lang="zh"><ContentZh /></div>}
</ArticleLayout>
