---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import Localized from '@/components/Localized.astro';
import { formatDate, formatDateZh } from '@/lib/content';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const translations = await getCollection('notesZh');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note, translation: translations.find((item) => item.data.source === note.id) }
  }));
}
const { note, translation } = Astro.props;
const { Content } = await render(note);
const translated = translation ? await render(translation) : null;
const ContentZh = translated?.Content;
---
<BaseLayout title={`${note.data.title} — Notes — MCX`} description={`A technical note about ${note.data.topic}.`}>
  <article class="note shell">
    <header>
      <a class="back" href="/notes/">← <Localized en="Notes" zh="笔记" /></a>
      <div class="note-meta"><time datetime={note.data.publishDate.toISOString()}><Localized en={formatDate(note.data.publishDate, 'long')} zh={formatDateZh(note.data.publishDate, 'long')} /></time><span data-lang="en"><Tag text={note.data.topic} /></span><span data-lang="zh"><Tag text={note.data.topicZh} /></span></div>
      <h1><Localized en={note.data.title} zh={note.data.titleZh} /></h1>
    </header>
    <div class="note-body"><div data-lang="en"><Content /></div>{ContentZh && <div data-lang="zh"><ContentZh /></div>}</div>
  </article>
</BaseLayout>
<style is:global>
  .note { max-width: 850px; padding-top: clamp(4rem, 9vw, 8rem); }
  .note .back { color: var(--ink-faint); font: .65rem/1 var(--mono); }
  .note .back:hover { color: var(--accent); }
  .note-meta { display: flex; align-items: center; gap: 1rem; margin-top: 4rem; color: var(--ink-faint); font: .63rem/1.4 var(--mono); }
  .note h1 { margin: 1.2rem 0 3.5rem; max-width: 800px; font: 460 clamp(3rem, 7vw, 5.8rem)/.95 var(--serif); letter-spacing: -.05em; }
  .note-body { max-width: 700px; color: var(--ink-soft); font-size: 1.04rem; line-height: 1.8; }
  .note-body p { margin: 0 0 1.4rem; }
</style>
