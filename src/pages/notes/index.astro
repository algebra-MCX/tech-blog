---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import EntryCard from '@/components/EntryCard.astro';
import { noteMap, noteTopics } from '@/data/library';
import { byNewest } from '@/lib/content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).filter(n => noteMap[n.id]?.noteCategory).sort(byNewest);
---
<BaseLayout title="Notes — Chenxi Ma" description="Personal essays and predictions about the future.">
  <header class="page-intro shell"><p class="eyebrow"><Localized en="Personal writing" zh="随笔与预测" /></p><h1><Localized en="Notes" zh="想法" /></h1><p><Localized en="Personal essays and predictions about the future." zh="个人随笔，以及对未来的预测。" /></p></header>
  <section class="library-section shell"><div class="route-cards">{noteTopics.map(s => <a class="route-card reading-glass" href={`/notes/topics/${s.id}/`}><h2><Localized en={s.en} zh={s.zh} /> <span aria-hidden="true">→</span></h2><p><Localized en={s.description} zh={s.descriptionZh} /></p><span class="eyebrow">{notes.filter(n => noteMap[n.id].noteTopic === s.id).length} <Localized en="notes" zh="则" /></span></a>)}</div><div class="section-heading section-spaced"><h2><Localized en="Recent notes" zh="近期想法" /></h2></div><div class="reading-glass chapter">{notes.map(n => <EntryCard href={`/notes/${n.id}/`} title={n.data.title} titleZh={n.data.titleZh} label={n.data.topic} labelZh={n.data.topicZh} />)}</div><p class="section-description"><Localized en="Everyday observations, personal reflections, and how I imagine the future." zh="写下日常的观察、自己的思考，以及对未来的想象与预测。" /></p></section>
</BaseLayout>
