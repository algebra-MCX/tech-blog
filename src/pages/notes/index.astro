---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import { byNewest, formatDate } from '@/lib/content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(byNewest);
---
<BaseLayout title="Notes — MCX" description="Short technical observations, experiments, and findings.">
  <header class="page-intro shell reveal">
    <p class="eyebrow">Laboratory notebook · {notes.length.toString().padStart(2, '0')} entries</p>
    <h1>Notes</h1>
    <p>Short technical observations, experiments, and findings. Small enough to remain specific.</p>
  </header>
  <section class="notes shell" aria-label="Technical notes">
    <div class="notes-head"><span>Date</span><span>Observation</span><span>Topic</span><span></span></div>
    {notes.map((note) => (
      <article class="note-row">
        <time datetime={note.data.publishDate.toISOString()}>{formatDate(note.data.publishDate)}</time>
        <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
        <Tag text={note.data.topic} />
        <a class="note-arrow" href={`/notes/${note.id}/`} aria-label={`Read ${note.data.title}`}><span aria-hidden="true">→</span></a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .notes { padding-top: clamp(3.5rem, 7vw, 6rem); }
  .notes-head, .note-row { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) 10rem 2rem; gap: 1.5rem; align-items: center; }
  .notes-head { padding: 0 0 .75rem; border-bottom: 1px solid var(--line); color: var(--ink-faint); font: .57rem/1.3 var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .note-row { min-height: 4.4rem; border-bottom: 1px solid var(--line-soft); transition: background .2s ease; }
  .note-row:hover { background: color-mix(in srgb, var(--surface) 38%, transparent); }
  time { color: var(--ink-faint); font: .64rem/1.4 var(--mono); }
  h2 { margin: 0; font-size: .82rem; font-weight: 490; line-height: 1.4; }
  h2 a:hover { color: var(--accent); }
  .note-row :global(.tag) { justify-self: start; }
  .note-arrow { justify-self: end; color: var(--ink-soft); transition: color .2s ease, transform .2s var(--ease-out); }
  .note-arrow:hover { color: var(--accent); transform: translateX(3px); }
  @media (max-width: 700px) {
    .notes-head { display: none; }
    .note-row { grid-template-columns: 1fr auto; gap: .45rem 1rem; padding: 1.1rem 0; }
    .note-row time { grid-column: 1; grid-row: 1; }
    .note-row h2 { grid-column: 1; grid-row: 2; font-size: .9rem; }
    .note-row :global(.tag) { grid-column: 2; grid-row: 1; }
    .note-arrow { grid-column: 2; grid-row: 2; }
  }
</style>
