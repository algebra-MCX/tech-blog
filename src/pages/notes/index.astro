---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import EntryCard from '@/components/EntryCard.astro';
import { noteMap, noteTopics } from '@/data/library';
import { byNewest } from '@/lib/content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).filter(n => noteMap[n.id]?.noteCategory).sort(byNewest);
---
<BaseLayout title="Notes — Chenxi Ma" description="Personal perspectives on research, learning, investing, life and personal finance.">
  <header class="page-intro shell"><p class="eyebrow"><Localized en="Thinking in public" zh="记录认识与思考" /></p><h1><Localized en="Notes" zh="想法" /></h1><p><Localized en="Personal perspectives on research, learning, investing, life and personal finance. Keep the assumptions visible; leave room to change a view." zh="记录对科研、学习、投资、生活与理财的认识，写清成立条件，也为修订判断留出空间。" /></p></header>
  <section class="library-section shell"><div class="route-cards">{noteTopics.map(s => <a class="route-card reading-glass" href={`/notes/topics/${s.id}/`}><h2><Localized en={s.en} zh={s.zh} /> <span aria-hidden="true">→</span></h2><p><Localized en={s.description} zh={s.descriptionZh} /></p><span class="eyebrow">{notes.filter(n => noteMap[n.id].noteTopic === s.id).length} <Localized en="notes" zh="则" /></span></a>)}</div><div class="section-heading section-spaced"><h2><Localized en="Recent notes" zh="近期想法" /></h2></div><div class="reading-glass chapter">{notes.map(n => <EntryCard href={`/notes/${n.id}/`} title={n.data.title} titleZh={n.data.titleZh} label={n.data.topic} labelZh={n.data.topicZh} />)}</div><p class="section-description"><Localized en="Topics organize what a note concerns. Perspectives, decisions and questions describe its form." zh="主题区分讨论范围，观点、取舍和开放问题区分表达类型。" /></p></section>
</BaseLayout>
