---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import EntryCard from '@/components/EntryCard.astro';
import { noteMap, noteTopics } from '@/data/library';
import { byNewest } from '@/lib/content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).filter(n => noteMap[n.id]?.noteCategory).sort(byNewest);
---
<BaseLayout title="Notes — Chenxi Ma" description="Views on the future of technology, essays on everyday life, and lessons from experience.">
  <header class="page-intro shell"><p class="eyebrow"><Localized en="Thoughts & experience" zh="思考与经验" /></p><h1><Localized en="Notes" zh="想法" /></h1><p><Localized en="Views on the future of technology, essays on everyday life, and lessons from experience." zh="对未来技术的判断、生活中的随笔，以及在不同领域积累的经验。" /></p></header>
  <section class="library-section shell"><div class="route-cards">{noteTopics.map(s => <a class="route-card reading-glass" href={`/notes/topics/${s.id}/`}><h2><Localized en={s.en} zh={s.zh} /> <span aria-hidden="true">→</span></h2><p><Localized en={s.description} zh={s.descriptionZh} /></p><span class="eyebrow">{notes.filter(n => noteMap[n.id].noteTopic === s.id).length} <Localized en="notes" zh="则" /></span></a>)}</div><div class="section-heading section-spaced"><h2><Localized en="Recent notes" zh="近期想法" /></h2></div><div class="reading-glass chapter">{notes.map(n => <EntryCard href={`/notes/${n.id}/`} title={n.data.title} titleZh={n.data.titleZh} label={n.data.topic} labelZh={n.data.topicZh} />)}</div><p class="section-description"><Localized en="Observations on technology, reflections on life, and experiences worth sharing." zh="记录对技术的观察、对生活的思考，也分享值得留下的经验。" /></p></section>
</BaseLayout>
