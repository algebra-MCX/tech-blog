---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import EntryCard from '@/components/EntryCard.astro';
import { noteMap, noteSections } from '@/data/library';
import { byNewest } from '@/lib/content';
export function getStaticPaths() { return noteSections.map(section => ({ params: { section: section.id }, props: { section } })); }
const { section } = Astro.props;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).filter(n => noteMap[n.id]?.noteCategory === section.id).sort(byNewest);
---
<BaseLayout title={`${section.en} — Notes — Chenxi Ma`} description={section.description}>
  <header class="page-intro shell"><a class="back-link" href="/notes/"><Localized en="← Notes" zh="← 想法" /></a><h1><Localized en={section.en} zh={section.zh} /></h1><p><Localized en={section.description} zh={section.descriptionZh} /></p></header>
  <section class="library-section shell"><nav class="section-tabs" aria-label="Note categories">{noteSections.map(s => <a href={`/notes/sections/${s.id}/`} aria-current={section.id === s.id ? 'page' : undefined}><Localized en={s.en} zh={s.zh} /></a>)}</nav>{notes.length ? <div class="chapter reading-glass">{notes.map(n => <EntryCard href={`/notes/${n.id}/`} title={n.data.title} titleZh={n.data.titleZh} label={n.data.topic} labelZh={n.data.topicZh} />)}</div> : <div class="empty-state reading-glass"><h2><Localized en="No notes published here yet" zh="这个分类尚未发布想法" /></h2><p><Localized en="Explore the existing perspectives, or follow the evidence in a project notebook." zh="可以先阅读已有观点，或在项目档案中查看相关证据。" /></p><a class="text-link" href="/notes/sections/perspectives/"><Localized en="Read perspectives →" zh="阅读技术观点 →" /></a></div>}</section>
</BaseLayout>
