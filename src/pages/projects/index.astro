---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Localized from '@/components/Localized.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
import { domains } from '@/data/library';
---
<BaseLayout title="Projects — Chenxi Ma" description="Project notebooks: scope, experiments, debugging, design and reproducible materials.">
  <header class="page-intro shell"><p class="eyebrow"><Localized en="Build. Measure. Understand." zh="实现、测量、理解。" /></p><h1><Localized en="Projects" zh="项目" /></h1><p><Localized en="Follow a question through the code, experiments and decisions behind it." zh="以项目为线索，深入一个问题背后的代码、实验与决策。" /></p></header>
  <section class="library-section shell" data-filter-list>
    <div class="filter-bar">
      <label><span><Localized en="Domain" zh="领域" /></span><select data-filter="domain"><option value="all">All / 全部</option>{domains.map(d => <option value={d.id}>{d.en} / {d.zh}</option>)}</select></label>
      <label><span><Localized en="Status" zh="状态" /></span><select data-filter="status"><option value="all">All / 全部</option><option value="active">In progress / 进行中</option><option value="completed">Completed / 已完成</option><option value="archived">Archived / 已归档</option></select></label>
      <span class="filter-count"><span data-filter-count>{projects.length}</span> <Localized en="projects" zh="个项目" /></span>
    </div>
    <div class="project-cards">{projects.map(project => <ProjectCard project={project} />)}</div>
    <p class="empty-state" data-filter-empty hidden><Localized en="No projects in this selection yet. Browse all projects or explore the guides." zh="这个分类暂时没有项目，可以浏览全部项目或前往指南。" /> <a class="text-link" href="/guides/"><Localized en="Guides →" zh="指南 →" /></a></p>
  </section>
</BaseLayout>
<script>import '@/scripts/filters';</script>
