---
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import Localized from '@/components/Localized.astro';
import { projects } from '@/data/projects';
import { projectSections } from '@/data/library';
import { getProjectContent, type ProjectView } from '@/lib/project-content';
import { readingMinutes } from '@/lib/content';
export function getStaticPaths() { return projects.flatMap(project => ['start', 'articles', 'resources'].map(view => ({ params: { id: project.id, view }, props: { project, view: view as ProjectView } }))); }
const { project, view } = Astro.props;
const { items, starts, originals, outlines, prs } = await getProjectContent(project);
const kinds = projectSections.filter(section => ['experiments', 'debugging', 'design'].includes(section.id) && items.some(item => item.kind === section.id));
---
<ProjectLayout project={project} view={view} count={items.length}>
  {view === 'start' && <section class="project-reading-path"><header class="project-section-heading"><p class="eyebrow"><Localized en="A guided way in" zh="按顺序开始" /></p><h2><Localized en="Start small. Then go deeper." zh="先看懂一个例子，再深入项目。" /></h2><p><Localized en="Read these in order. Each step gives you a clearer question to take into the project." zh="建议按这个顺序阅读，每一步都为进入项目补齐一个关键理解。" /></p></header><ol class="reading-steps">{starts.map((entry, index) => <li><span class="reading-step-number">{String(index + 1).padStart(2, '0')}</span><div><p class="reading-step-meta"><Localized en={index === 0 ? 'Start here' : 'Next'} zh={index === 0 ? '从这里开始' : '接着读'} /> · {readingMinutes(entry.body)} <Localized en="min read" zh="分钟阅读" /></p><h3><a href={`/guides/${entry.id}/?project=${project.id}`}><Localized en={entry.data.title} zh={entry.data.titleZh} /> →</a></h3><p><Localized en={entry.data.description} zh={entry.data.descriptionZh} /></p></div></li>)}</ol><a class="reading-step-finish" href={`/projects/${project.id}/articles/`}><span class="reading-step-number">{String(starts.length + 1).padStart(2, '0')}</span><div><strong><Localized en="Continue into the project" zh="进入项目文章" /></strong><span><Localized en="Follow the experiments, investigations and design choices." zh="继续查看实验、排障与设计取舍。" /></span></div><span aria-hidden="true">→</span></a></section>}
  {view === 'articles' && <section class="project-article-browser" data-filter-list><header class="project-section-heading"><p class="eyebrow"><Localized en="Explore the work" zh="按问题翻阅" /></p><h2><Localized en="Articles & investigations" zh="文章与研究记录" /></h2><p><Localized en="Choose a subject below. Original repository documents and working outlines are marked separately." zh="按实验、排障或设计查找。原始仓库文档与研究提纲会分别标明。" /></p></header><div class="project-article-tools"><input type="hidden" data-filter="kind" value="all" /><div class="project-kind-nav" role="group" aria-label="Article category / 文章分类"><button type="button" data-filter-pick="kind" data-value="all" aria-pressed="true"><Localized en="All" zh="全部" /><span>{items.length}</span></button>{kinds.map(kind => <button type="button" data-filter-pick="kind" data-value={kind.id} aria-pressed="false"><Localized en={kind.en} zh={kind.zh} /><span>{items.filter(item => item.kind === kind.id).length}</span></button>)}</div><label class="project-article-search"><span class="sr-only"><Localized en="Search this project" zh="搜索本项目" /></span><input type="search" data-filter="query" placeholder="Search / 搜索" /></label></div><div class="project-article-list">{items.map(item => { const kind = projectSections.find(section => section.id === item.kind)!; return <a class="project-article-row" href={item.href} data-filter-row data-kind={item.kind} data-search={`${item.title} ${item.titleZh} ${item.description ?? ''} ${item.descriptionZh ?? ''}`}><div><p class="project-row-meta"><span><Localized en={kind.en} zh={kind.zh} /></span><span class:list={['material-state', { 'material-state--outline': item.source === 'outline' }]}><Localized en={item.source === 'repository' ? 'GitHub document' : item.source === 'pull-request' ? `PR · ${item.state === 'merged' ? 'Merged' : item.state === 'open' ? 'In review' : 'Closed'}` : 'Working outline'} zh={item.source === 'repository' ? '仓库原始文档' : item.source === 'pull-request' ? `PR · ${item.state === 'merged' ? '已合并' : item.state === 'open' ? '审阅中' : '已关闭'}` : '研究提纲'} /></span></p><h3><Localized en={item.title} zh={item.titleZh} /></h3>{item.description && <p class="project-row-description"><Localized en={item.description} zh={item.descriptionZh ?? item.description} /></p>}</div><span class="project-row-arrow" aria-hidden="true">{item.source !== 'outline' ? '↗' : '→'}</span></a>; })}</div><p class="empty-state" data-filter-empty hidden><Localized en={items.length ? "No matching articles. Try another category or a shorter search." : "Articles will appear here as they are written."} zh={items.length ? "没有匹配文章，可以切换分类或缩短关键词。" : "文章会随着实际写作逐步补充。"} />{items.length === 0 && <><br /><a href={`/projects/${project.id}/resources/`}><Localized en="View code & contribution records →" zh="先看代码与贡献记录 →" /></a></>}</p><p class="project-list-caption">{originals.length} <Localized en="repository documents" zh="份仓库文档" /> · {outlines.length} <Localized en="working outlines" zh="篇研究提纲" /></p></section>}
  {view === 'resources' && <section class="project-resources"><header class="project-section-heading"><p class="eyebrow"><Localized en="Inspect & reproduce" zh="查看与复现" /></p><h2><Localized en="Code & original materials" zh="代码与原始材料" /></h2><p><Localized en="Open the repository for implementation and version history. Use the original documents to check experimental conditions." zh="前往仓库查看实现与版本历史，通过原始文档核对实验条件。" /></p></header><a class="repository-feature" href={project.repository}><span><span class="eyebrow">GitHub</span><strong>{project.repository.replace('https://github.com/', '')}</strong></span><span aria-hidden="true">↗</span></a><div class="project-source-list">{project.resources.map(resource => <a href={resource.url}><Localized en={resource.title} zh={resource.titleZh} /><span aria-hidden="true">↗</span></a>)}</div>{prs.length > 0 && <section class="project-pull-requests"><h3><Localized en="Pull requests" zh="贡献记录" /></h3><div class="project-source-list">{prs.map(pr => <a href={pr.href}><span>{pr.title}</span><span class:list={['pr-state', `pr-state--${pr.state}`]}><Localized en={pr.state === 'merged' ? 'Merged' : pr.state === 'open' ? 'In review' : 'Closed'} zh={pr.state === 'merged' ? '已合并' : pr.state === 'open' ? '审阅中' : '已关闭'} /></span></a>)}</div></section>}<p class="project-list-caption"><Localized en="For reproduction, record the exact commit, inputs, environment and measurement boundary." zh="复现时请记录具体 Commit、输入、环境与测量边界。" /></p></section>}
</ProjectLayout>
<script>import '@/scripts/filters';</script>
