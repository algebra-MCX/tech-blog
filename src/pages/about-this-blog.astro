---
import { getEntry, getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { site, learningDestination } from '@/data/site';
const entry = await getEntry('guides', 'how-to-read');
if (!entry) throw new Error('Missing blog introduction');
const translation = (await getCollection('guidesZh')).find(item => item.data.source === entry.id);
const { Content, headings } = await render(entry);
const translated = translation ? await render(translation) : null;
const ContentZh = translated?.Content;
---
<ArticleLayout entry={entry} headings={headings} headingsZh={translated?.headings}>
  <div data-lang="en"><Content /></div>
  {ContentZh && <div data-lang="zh"><ContentZh /></div>}
  <nav class="learning-destination"><a href={site.learning}><span data-lang="en">Learning hub</span><span data-lang="zh">独立学习站</span></a><a href={learningDestination('/guides/sections/quickstarts/') ?? '/guides/sections/quickstarts/'}><span data-lang="en">Quickstarts</span><span data-lang="zh">最简入门</span></a></nav>
</ArticleLayout>
<style>.learning-destination{display:flex;flex-wrap:wrap;gap:24px;margin-top:28px;font-size:16px}</style>
