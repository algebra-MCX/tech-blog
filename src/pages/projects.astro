---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import Localized from '@/components/Localized.astro';
import { projects } from '@/data/projects';
---
<BaseLayout title="Projects — Chenxi Ma" description="Selected technical projects, open-source contributions, and systems research explorations.">
  <header class="page-intro shell reveal">
    <p class="eyebrow"><Localized en="Selected systems work" zh="精选系统工作" /> · {projects.length.toString().padStart(2, '0')}</p>
    <h1><Localized en="Projects" zh="项目" /></h1>
    <p><Localized en="Technical projects and explorations in GPU systems and efficient inference." zh="GPU 系统与高效推理相关的技术项目和探索。" /></p>
  </header>
  <section class="project-list shell">
    {projects.map((project) => (
      <article class="project-feature">
        <div class="project-content">
          <div class="project-topline"><div>{project.tags.map((tag) => <Tag text={tag} />)}</div><span><Localized en={project.status} zh={project.statusZh} /></span></div>
          <h2><Localized en={project.title} zh={project.titleZh} /></h2>
          <p class="summary"><Localized en={project.summary} zh={project.summaryZh} /></p>
          <dl>{project.details.map((detail) => <><dt><Localized en={detail.label} zh={detail.labelZh} /></dt><dd><Localized en={detail.value} zh={detail.valueZh} /></dd></>)}</dl>
          <div class="project-links"><a class="text-link" href={project.article}><Localized en="Read analysis" zh="阅读分析" /> <span class="arrow">→</span></a>{project.repository && <a class="text-link" href={project.repository}>GitHub ↗</a>}</div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

