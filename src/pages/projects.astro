---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Geometry from '@/components/Geometry.astro';
import Tag from '@/components/Tag.astro';
import { projects } from '@/data/projects';
---
<BaseLayout title="Projects — MCX" description="Selected technical projects, open-source contributions, and systems research explorations.">
  <header class="page-intro shell reveal">
    <p class="eyebrow">Selected systems work · {projects.length.toString().padStart(2, '0')}</p>
    <h1>Projects</h1>
    <p>Selected technical projects, open-source contributions, and research explorations. Status is stated conservatively.</p>
  </header>
  <section class="project-list shell">
    {projects.map((project, index) => (
      <article class="project-feature">
        <div class="project-index">{project.index}</div>
        <div class="diagram-wrap">
          {index === 0 ? <Geometry variant="projects" /> : (
            <div class="system-diagram" aria-label="Abstract execution stages">
              <span>Route</span><i></i><span>Dispatch</span><i></i><span>Compute</span><i></i><span>Combine</span>
            </div>
          )}
        </div>
        <div class="project-content">
          <div class="project-topline"><div>{project.tags.map((tag) => <Tag text={tag} />)}</div><span>{project.status}</span></div>
          <h2>{project.title}</h2>
          <p class="summary">{project.summary}</p>
          <dl>{Object.entries(project.details).map(([label, value]) => <><dt>{label}</dt><dd>{value}</dd></>)}</dl>
          <div class="project-links"><a class="text-link" href={project.article}>Read analysis <span class="arrow">→</span></a>{project.repository && <a class="text-link" href={project.repository}>GitHub ↗</a>}</div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .project-list { padding-top: 1rem; }
  .project-feature { display: grid; grid-template-columns: 3rem minmax(260px, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 8vw, 7rem); border-bottom: 1px solid var(--line); }
  .project-index { color: var(--accent); font: .7rem/1 var(--mono); padding-top: .5rem; }
  .diagram-wrap { display: grid; place-items: center; min-height: 340px; background: radial-gradient(circle at center, var(--accent-soft), transparent 62%); }
  .diagram-wrap :global(.geometry) { width: min(100%, 330px); height: 390px; }
  .project-topline { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .project-topline > div { display: flex; flex-wrap: wrap; gap: .35rem; }
  .project-topline > span { color: var(--ink-faint); font: .6rem/1 var(--mono); text-transform: uppercase; }
  h2 { margin: 1.5rem 0 1rem; max-width: 750px; font: 470 clamp(2.25rem, 4vw, 4rem)/.98 var(--serif); letter-spacing: -.045em; }
  .summary { max-width: 650px; margin: 0 0 2.3rem; color: var(--ink-soft); font-size: .88rem; line-height: 1.7; }
  dl { display: grid; grid-template-columns: 7rem 1fr; gap: .55rem 1.2rem; margin: 0 0 2.2rem; padding-top: 1.2rem; border-top: 1px solid var(--line-soft); font-size: .68rem; }
  dt { color: var(--ink-faint); font-family: var(--mono); }
  dd { margin: 0; color: var(--ink-soft); }
  .project-links { display: flex; gap: 1.5rem; }
  .system-diagram { position: relative; display: grid; justify-items: center; color: var(--ink-soft); font: .59rem/1 var(--mono); text-transform: uppercase; letter-spacing: .07em; }
  .system-diagram span { min-width: 7rem; padding: .8rem 1rem; border: 1px solid var(--line); text-align: center; background: var(--bg); }
  .system-diagram i { width: 1px; height: 2.4rem; background: var(--line-geometry); }
  .system-diagram span:nth-of-type(3) { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); color: var(--accent); }
  @media (max-width: 850px) {
    .project-feature { grid-template-columns: 2rem 1fr; }
    .diagram-wrap { grid-column: 1 / -1; grid-row: 2; min-height: 260px; }
    .diagram-wrap :global(.geometry) { height: 300px; }
    .project-content { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .project-feature { grid-template-columns: 1fr; gap: 1.5rem; }
    .project-index, .project-content, .diagram-wrap { grid-column: 1; }
    .diagram-wrap { grid-row: auto; }
    dl { grid-template-columns: 1fr; gap: .15rem; }
    dd { margin-bottom: .65rem; }
  }
</style>
