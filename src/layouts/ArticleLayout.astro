---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import Localized from '@/components/Localized.astro';
import { formatDate, formatDateZh, readingMinutes } from '@/lib/content';
import { writingMap, guideSections, projectSections } from '@/data/library';
import { projectById } from '@/data/projects';
import GuideProjectContext from '@/components/GuideProjectContext.astro';

interface Props {
  entry: CollectionEntry<'writing'> | CollectionEntry<'guides'>;
  headings: { depth: number; slug: string; text: string }[];
  headingsZh?: { depth: number; slug: string; text: string }[];
}
const { entry, headings, headingsZh = [] } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2);
const tocZh = headingsZh.filter((heading) => heading.depth === 2);
const contents = [{ language: 'en', headings: toc }, { language: 'zh', headings: tocZh }];
const assignment = entry.collection === 'writing' ? writingMap[entry.id] : undefined;
const project = projectById(assignment?.project);
const guideSection = entry.collection === 'guides' ? guideSections.find(s => s.id === entry.data.category) : undefined;
const section = projectSections.find(s => s.id === assignment?.section);
const parentHref = project ? `/projects/${project.id}/` : guideSection ? `/guides/sections/${guideSection.id}/` : '/writing/';
const parentEn = project?.title ?? guideSection?.en ?? 'All articles';
const parentZh = project?.titleZh ?? guideSection?.zh ?? '全部文章';
const projectWriting = project ? (await getCollection('writing', ({ data }) => !data.draft)).filter(item => writingMap[item.id]?.project === project.id).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()) : [];
const nextArticle = projectWriting[projectWriting.findIndex(item => item.id === entry.id) + 1];
---
<BaseLayout title={`${entry.data.title} — Chenxi Ma`} description={entry.data.description} article>
  {entry.collection === 'guides' && <GuideProjectContext guideId={entry.id} position="top" />}
  <article class="article">
    <header class="article-header shell reading-glass">
      <div class="article-meta reveal">
        <nav aria-label="Breadcrumb"><a href={entry.collection === 'guides' ? '/guides/' : '/projects/'}><Localized en={entry.collection === 'guides' ? 'Guides' : 'Projects'} zh={entry.collection === 'guides' ? '指南' : '项目'} /></a><span>›</span><a href={parentHref}><Localized en={parentEn} zh={parentZh} /></a>{section && project && <><span>›</span><a href={`/projects/${project.id}/articles/?kind=${section.id}`}><Localized en={section.en} zh={section.zh} /></a></>}</nav>
        <p><time datetime={entry.data.publishDate.toISOString()}><Localized en={formatDate(entry.data.publishDate)} zh={formatDateZh(entry.data.publishDate)} /></time><span>·</span>{readingMinutes(entry.body)} <Localized en="min read" zh="分钟阅读" /></p>
      </div>
      <div class="article-hero">
        <div class="article-title reveal reveal--2">
          {'eyebrow' in entry.data && entry.data.eyebrow && <p class="eyebrow"><Localized en={entry.data.eyebrow} zh={entry.data.eyebrowZh ?? entry.data.eyebrow} /></p>}
          <h1><Localized en={entry.data.title} zh={entry.data.titleZh} /></h1>
          <p class="dek"><Localized en={entry.data.description} zh={entry.data.descriptionZh} /></p>
          <div class="article-tags">{entry.data.tags.map((tag) => <Tag text={tag} href={entry.collection === 'guides' ? `/search/?type=guide&query=${encodeURIComponent(tag)}` : `/writing/?tag=${encodeURIComponent(tag)}`} />)}</div>
          {assignment?.state === 'outline' && <p class="reading-status"><strong><Localized en="Working outline" zh="研究提纲" /></strong> · <Localized en="Hypotheses and measurement plans; verified results are still being attached." zh="包含假设与测量计划，经验证的结果仍在补充中。" /></p>}
        </div>
      </div>
    </header>

    <div class="mobile-toc shell">
      <details class="reading-glass">
        <summary><Localized en="Contents" zh="目录" /> <span>{toc.length.toString().padStart(2, '0')} <Localized en="sections" zh="节" /></span></summary>
        {contents.map((list) => <ol data-lang={list.language}>{list.headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>)}
      </details>
    </div>

    <div class="article-grid shell">
      <aside class="toc reading-glass" aria-label="Table of contents">
        <p><Localized en="Contents" zh="目录" /></p>
        {contents.map((list) => <ol data-lang={list.language}>{list.headings.map((heading, index) => <li><a href={`#${heading.slug}`} data-toc-link><span>{String(index + 1).padStart(2, '0')}.</span><span>{heading.text}</span></a></li>)}</ol>)}
      </aside>
      <div class="prose reading-glass"><slot />{project && nextArticle && <a class="project-next-article" href={`/writing/${nextArticle.id}/`}><span class="eyebrow">{project.title} · <Localized en="Next in this project" zh="接着读" /></span><strong><Localized en={nextArticle.data.title} zh={nextArticle.data.titleZh} /> →</strong><span><Localized en="Working outline" zh="研究提纲" /></span></a>}{entry.collection === 'guides' && <GuideProjectContext guideId={entry.id} position="next" />}<nav class="article-return" data-guide-return={entry.collection === 'guides' ? true : undefined} aria-label="Continue reading"><a href={project ? `/projects/${project.id}/articles/` : parentHref}><Localized en={project ? `← ${parentEn} articles` : `← Back to ${parentEn}`} zh={project ? `← ${parentZh}的全部文章` : `← 返回${parentZh}`} /></a>{project && <a href={`/projects/${project.id}/start/`}><Localized en="Reading path →" zh="阅读路线 →" /></a>}</nav></div>
    </div>
  </article>
</BaseLayout>

<script>
  let tocObserver: IntersectionObserver | undefined;
  const setupToc = () => {
    tocObserver?.disconnect();
    const language = document.documentElement.dataset.language === 'zh' ? 'zh' : 'en';
    const links = [...document.querySelectorAll<HTMLAnchorElement>(`.toc [data-lang="${language}"] [data-toc-link]`)];
    const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    tocObserver = new IntersectionObserver((entries) => {
      const visible = entries.filter((item) => item.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      links.forEach((link) => {
        if (decodeURIComponent(link.hash.slice(1)) === visible.target.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });
    sections.forEach((section) => tocObserver?.observe(section));
  };
  window.addEventListener('mcx:language-change', setupToc);
  const setupArticle = async () => {
    setupToc();
    const blocks = [...document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"] > code')];
    if (blocks.length) {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({ startOnLoad: false, theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'neutral', securityLevel: 'strict', fontFamily: 'Nunito Sans, sans-serif' });
      for (const [index, block] of blocks.entries()) {
        const pre = block.parentElement;
        if (!pre || pre.dataset.rendered) continue;
        pre.dataset.rendered = 'true';
        const container = document.createElement('div'); container.className = 'mermaid-diagram';
        try { const { svg } = await mermaid.render(`mermaid-${index}-${Date.now()}`, block.textContent ?? ''); container.innerHTML = svg; pre.replaceWith(container); } catch { /* Keep source visible if Mermaid cannot render. */ }
      }
    }
  };
  setupArticle(); document.addEventListener('astro:page-load', setupArticle);
</script>

