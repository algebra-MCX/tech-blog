---
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  articleDetails?: { headline: string; published: Date; modified?: Date };
  noindex?: boolean;
  siteKind?: 'research' | 'learning';
}
const {
  title = 'Chenxi Ma — Algorithms, Data & Infrastructure',
  description = 'Original analysis, measured experiments and upstream engineering in LLM inference and GPU systems.',
  image = '/og-inference.png',
  article = false,
  articleDetails,
  noindex = false,
  siteKind = 'research'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const landingPage = Astro.url.pathname === import.meta.env.BASE_URL;
const socialImage = new URL(import.meta.env.BASE_URL + image.replace(/^\//, ''), canonical);
const published = articleDetails?.published.toISOString();
const modified = articleDetails?.modified?.toISOString();
const author = new URL('/#chenxi-ma', canonical).href;
const articleSchema = articleDetails && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: canonical.href,
  headline: articleDetails.headline,
  description,
  image: socialImage.href,
  datePublished: published,
  dateModified: modified,
  author: { '@type': 'Person', '@id': author, name: 'Chenxi Ma', url: canonical.origin + '/' }
}).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en" data-theme="dark" data-language="en" data-site-kind={siteKind} data-landing-page={landingPage || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#131820" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {siteKind === 'research' && <link rel="alternate" type="application/rss+xml" title="Chenxi Ma — Writing" href="/rss.xml" />}
    <meta property="og:type" content={article || articleDetails ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        let savedLanguage;
        try { savedLanguage = localStorage.getItem('mcx-language-v2'); } catch {}
        const requested = new URLSearchParams(location.search).get('lang');
        const language = (requested === 'zh' || requested === 'en' ? requested : savedLanguage) === 'zh' ? 'zh' : 'en';
        if (requested === 'zh' || requested === 'en') {
          try { localStorage.setItem('mcx-language-v2', language); } catch {}
        }
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
      })();
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="glass-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="interaction-ripples" aria-hidden="true"></div>
    <Header siteKind={siteKind} />
    <main id="main-content"><slot /></main>
    <Footer siteKind={siteKind} />
    <script>
      const setupLanguage = () => {
        const updateCrossSiteLinks = () => document.querySelectorAll<HTMLAnchorElement>('[data-cross-site]').forEach(link => {
          const url = new URL(link.href, location.href);
          url.searchParams.set('lang', document.documentElement.dataset.language === 'zh' ? 'zh' : 'en');
          link.href = url.href;
        });
        updateCrossSiteLinks();
        window.addEventListener('mcx:language-change', updateCrossSiteLinks);
        document.querySelectorAll<HTMLButtonElement>('[data-language-toggle]').forEach((button) => {
          if (button.dataset.ready) return;
          button.dataset.ready = 'true';
          button.addEventListener('click', () => {
            const next = document.documentElement.dataset.language === 'zh' ? 'en' : 'zh';
            document.documentElement.dataset.language = next;
            document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
            try { localStorage.setItem('mcx-language-v2', next); } catch {}
            const url = new URL(location.href);
            if (url.searchParams.has('lang')) { url.searchParams.set('lang', next); history.replaceState(null, '', url); }
            window.dispatchEvent(new CustomEvent('mcx:language-change', { detail: next }));
          });
        });
      };
      setupLanguage();
      document.addEventListener('astro:page-load', setupLanguage);
    </script>
  </body>
</html>
