---
import type { CollectionEntry } from 'astro:content';
import Localized from './Localized.astro';
import ResearchFilters from './ResearchFilters.astro';
import TechnicalTags from './TechnicalTags.astro';
import { categoryLabel } from '@/data/research';
import { guideSections } from '@/data/library';
import '@/styles/research.css';
interface Props { entries: CollectionEntry<'guides'>[] }
const { entries } = Astro.props;
---
<section class="library-section shell" data-research-browser aria-label="Quickstarts / 最简入门">
  <h1 class="sr-only"><Localized en="Quickstarts" zh="最简入门" /></h1>
  <ResearchFilters total={entries.length} noun="examples" />
  <div class="research-results-stage" data-research-stage>
    <div class="research-grid" data-research-results>{entries.map(entry => <article class="reading-glass research-quickstart" data-research-item data-primary-category={entry.data.primaryCategory}>
      <span class="research-primary-category">{categoryLabel(entry.data.primaryCategory!)}</span>
      <h2><a href={`/guides/${entry.id}/`}><Localized en={entry.data.title} zh={entry.data.titleZh} /></a></h2>
      <p class="research-contribution"><Localized en={entry.data.description} zh={entry.data.descriptionZh} /></p>
      <TechnicalTags tags={entry.data.technicalTags!} />
      <div class="research-card-footer"><span class="research-relationship"><Localized en="Runnable example" zh="可运行的小例子" /></span><a class="text-link" href={`/guides/${entry.id}/`}><Localized en="Try it →" zh="开始动手 →" /></a></div>
    </article>)}</div>
    <div class="research-empty" data-research-empty hidden><h2><Localized en="No examples here yet" zh="这个领域暂未收录入门例子" /></h2><p><Localized en="Choose All or another field to find a starting point." zh="可以选择 All 或其他领域，找到一个动手起点。" /></p></div>
  </div>
  <nav class="quickstart-guide-links" aria-label="More guides / 更多指南">{guideSections.filter(section => section.id !== 'quickstarts').map(section => <a href={`/guides/sections/${section.id}/`}><Localized en={section.en} zh={section.zh} /><span aria-hidden="true"> →</span></a>)}</nav>
</section>
