---
import type { CollectionEntry } from 'astro:content';
import Localized from './Localized.astro';
import { formatCompactDate, formatCompactDateZh } from '@/lib/content';
interface Props { entry: CollectionEntry<'writing'>; compact?: boolean }
const { entry, compact = false } = Astro.props;
---
<article class="writing-row" data-writing-row data-tags={entry.data.tags.join('|').toLowerCase()}>
  <div class="writing-main">
    <h3><a href={`/writing/${entry.id}/`}><Localized en={entry.data.title} zh={entry.data.titleZh} /></a></h3>
    {!compact && <p><Localized en={entry.data.description} zh={entry.data.descriptionZh} /></p>}
  </div>
  <div class="writing-meta">
    <time datetime={entry.data.publishDate.toISOString()}><Localized en={formatCompactDate(entry.data.publishDate)} zh={formatCompactDateZh(entry.data.publishDate)} /></time>
    <span>{entry.data.readingTime} <Localized en="min read" zh="分钟阅读" /></span>
  </div>
</article>
