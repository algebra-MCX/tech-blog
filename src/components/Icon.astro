---
interface Props { name: 'search' | 'sun' | 'moon' | 'github' | 'mail' | 'x' | 'arrow' | 'menu' | 'close' }
const { name } = Astro.props;
const paths: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>',
  sun: '<circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/>',
  moon: '<path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"/>',
  github: '<path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.93c.46.08.63-.2.63-.44v-1.78c-2.58.56-3.12-1.1-3.12-1.1-.42-1.08-1.03-1.37-1.03-1.37-.84-.58.06-.57.06-.57.93.07 1.42.96 1.42.96.83 1.42 2.17 1.01 2.7.77.08-.6.32-1.01.59-1.25-2.06-.23-4.23-1.03-4.23-4.59 0-1.01.36-1.84.96-2.49-.1-.23-.42-1.18.09-2.45 0 0 .78-.25 2.53.95A8.8 8.8 0 0 1 12 7.06a8.7 8.7 0 0 1 2.3.31c1.75-1.2 2.53-.95 2.53-.95.5 1.27.19 2.22.09 2.45.6.65.96 1.48.96 2.49 0 3.57-2.17 4.35-4.24 4.58.33.29.63.85.63 1.72v2.63c0 .24.17.53.64.44A9.2 9.2 0 0 0 12 2.8Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  x: '<path d="m5 4 14 16M19 4 5 20"/>',
  arrow: '<path d="M4 12h15M14 7l5 5-5 5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m5 5 14 14M19 5 5 19"/>'
};
---
<svg class:list={['icon', { 'icon--github': name === 'github' }]} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />

<style>
  .icon { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
  .icon--github :global(path) { fill: currentColor; stroke: none; }
</style>
