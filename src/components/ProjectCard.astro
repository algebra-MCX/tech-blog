---
import Localized from './Localized.astro';
import { type Project, repositoryName, projectContributions } from '@/data/projects';
import RepositoryStars from './RepositoryStars.astro';
import { domains } from '@/data/library';
import { getProjectContent } from '@/lib/project-content';
interface Props { project: Project; hidden?: boolean }
const { project, hidden = false } = Astro.props;
const { items, starts } = await getProjectContent(project);
const prs = projectContributions(project);
const merged = prs.filter(pr => pr.state === 'merged').length;
---
<article class="project-card reading-glass" hidden={hidden} data-filter-row data-kind={project.kind} data-domain={project.domains.join('|')} data-status={project.status} data-search={`${project.title} ${project.summary} ${project.summaryZh}`}>
  <div class="card-topline"><span class="project-relationship"><Localized en={project.kind === 'own' ? 'Personal project' : merged ? 'Contributor · merged PR' : 'PR author · in review'} zh={project.kind === 'own' ? '自己的项目' : merged ? '贡献者 · 已有 PR 合并' : 'PR 作者 · 审阅中'} /></span><span>{project.domains.map(id => { const domain = domains.find(d => d.id === id)!; return <span class="domain-label"><Localized en={domain.en} zh={domain.zh} /></span>; })}</span></div>
  <div class="project-card-title"><h2><a href={`/projects/${project.id}/`}>{project.title}</a></h2><RepositoryStars repository={repositoryName(project)} /></div>
  <p class="project-subtitle"><Localized en={project.subtitle} zh={project.subtitleZh} /></p>
  <p><Localized en={project.scope} zh={project.scopeZh} /></p>
  <p class="project-card-inventory">{project.kind === 'contributor' ? <>{prs.length} <Localized en="upstream PRs" zh="个上游 PR" />{merged > 0 && <> · {merged} <Localized en="merged" zh="个已合并" /></>}</> : <>{starts.length} <Localized en="starting points" zh="个入门起点" /> <span aria-hidden="true">·</span> {items.length} <Localized en="articles & records" zh="篇文章与记录" /></>}</p>
  <div class="project-links"><a class="text-link" href={`/projects/${project.id}/`}><Localized en="Open notebook →" zh="打开项目档案 →" /></a></div>
</article>
