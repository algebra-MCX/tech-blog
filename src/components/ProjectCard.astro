---
import Localized from './Localized.astro';
import { projects } from '@/data/projects';
import { domains } from '@/data/library';
import { getProjectContent } from '@/lib/project-content';
interface Props { project: typeof projects[number] }
const { project } = Astro.props;
const { items, starts } = await getProjectContent(project);
---
<article class="project-card reading-glass" data-filter-row data-domain={project.domains.join('|')} data-status={project.status} data-search={`${project.title} ${project.summary} ${project.summaryZh}`}>
  <div class="card-topline"><span class="status-dot"><Localized en="In progress" zh="进行中" /></span><span>{project.domains.map(id => { const domain = domains.find(d => d.id === id)!; return <span class="domain-label"><Localized en={domain.en} zh={domain.zh} /></span>; })}</span></div>
  <h2><a href={`/projects/${project.id}/`}>{project.title}<span aria-hidden="true"> →</span></a></h2>
  <p class="project-subtitle"><Localized en={project.subtitle} zh={project.subtitleZh} /></p>
  <p><Localized en={project.scope} zh={project.scopeZh} /></p>
  <p class="project-card-inventory">{starts.length} <Localized en="starting points" zh="个入门起点" /> <span aria-hidden="true">·</span> {items.length} <Localized en="articles & records" zh="篇文章与记录" /></p>
  <div class="project-links"><a class="text-link" href={`/projects/${project.id}/`}><Localized en="Open notebook →" zh="打开项目档案 →" /></a></div>
</article>
