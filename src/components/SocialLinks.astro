---
import Icon from './Icon.astro';
import { site } from '@/data/site';
---
<div class="social-links" aria-label="Contact links">
  <a class="social-link glass-control" href={`mailto:${site.email}`}><Icon name="mail" /><span data-lang="en">Email</span><span data-lang="zh">邮箱</span></a>
  <a class="social-link glass-control" href={site.github}><Icon name="github" />GitHub</a>
  <a class="social-link glass-control" href={site.x}><Icon name="x" />X</a>
</div>
