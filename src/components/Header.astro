---
import Icon from './Icon.astro';
import Localized from './Localized.astro';
import { site } from '@/data/site';
const path = Astro.url.pathname;
const nav = [
  { href: '/', en: 'Blog', zh: '博客', active: path === '/' },
  { href: '/writing/', en: 'Writing', zh: '文章', active: path.startsWith('/writing/') },
  { href: '/notes/', en: 'Notes', zh: '笔记', active: path.startsWith('/notes/') },
  { href: site.homepage, en: 'Home ↗', zh: '个人主页 ↗', active: false }
];
---
<header class="site-header shell glass-surface">
  <a class="wordmark" href="/">Chenxi Ma</a>
  <nav class="primary-nav" aria-label="Main navigation">
    <span class="nav-lens" aria-hidden="true"></span>
    {nav.map((item) => <a href={item.href} aria-current={item.active ? 'page' : undefined}><Localized en={item.en} zh={item.zh} /></a>)}
  </nav>
  <div class="header-actions">
    <button class="language-toggle glass-control" type="button" aria-label="切换中英文 / Switch language" data-language-toggle><span data-lang="en">中文</span><span data-lang="zh">English</span></button>
    <button class="icon-button theme-toggle glass-control" type="button" aria-label="Switch color theme" data-theme-toggle>
      <span class="theme-icon theme-icon--sun"><Icon name="sun" /></span>
      <span class="theme-icon theme-icon--moon"><Icon name="moon" /></span>
    </button>
  </div>
</header>
<script>
  import '@/scripts/glass.js';
</script>
