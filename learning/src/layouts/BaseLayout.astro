---
import '../styles/global.css';
import '../styles/learning.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import 'katex/dist/katex.min.css';
const {title='Learning Hub — Chenxi Ma',description='Project-driven AI systems learning paths and runnable examples.'} = Astro.props;
const mainBlog = import.meta.env.PUBLIC_MAIN_BLOG_URL || 'https://tech-blog-chi.vercel.app';
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-language="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="description" content={description} />
<title>{title}</title>
{Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
<script is:inline>
  (() => {
    let lang = 'en';
    try { lang = localStorage.getItem('mcx-language-v2') || 'en'; } catch {}
    lang = lang === 'zh' ? 'zh' : 'en';
    document.documentElement.dataset.language = lang;
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
  })();
</script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header shell glass-surface">
  <a href="/" class="wordmark">Chenxi Ma <span class="hub-wordmark">/ Learning</span></a>
  <nav class="primary-nav" aria-label="Main navigation">
    <a href="/" aria-current={current === '/' ? 'page' : undefined}><span data-lang="en">Learning</span><span data-lang="zh">学习资料</span></a>
    <a href="/guides/sections/quickstarts/" aria-current={current.includes('quickstarts') ? 'page' : undefined}><span data-lang="en">Quickstarts</span><span data-lang="zh">最简入门</span></a>
    <a href={mainBlog}><span data-lang="en">Research ↗</span><span data-lang="zh">研究博客 ↗</span></a>
  </nav>
  <button class="language-toggle glass-control" type="button" aria-label="Switch language / 切换语言" data-language-toggle>
    <span data-lang="en">中文</span><span data-lang="zh">English</span>
  </button>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer shell"><p>© {new Date().getFullYear()} Chenxi Ma</p>
<nav aria-label="Footer"><a href={mainBlog}>Research ↗</a><a href="https://github.com/algebra-MCX">GitHub ↗</a><a href="https://algebra-mcx.github.io/">Homepage ↗</a></nav></footer>
<script is:inline>
  (() => {
    const setup = () => document.querySelectorAll('[data-language-toggle]').forEach(button => {
      if (button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        const lang = document.documentElement.dataset.language === 'zh' ? 'en' : 'zh';
        document.documentElement.dataset.language = lang;
        document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
        try { localStorage.setItem('mcx-language-v2', lang); } catch {}
      });
    });
    setup(); document.addEventListener('astro:page-load',setup);
  })();
</script>
</body></html>
