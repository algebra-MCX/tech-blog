---
import SharedLayout from '../../../src/layouts/BaseLayout.astro';
import '../styles/learning.css';
import type { ComponentProps } from 'astro/types';
type Props = Omit<ComponentProps<typeof SharedLayout>, 'siteKind'>;
const {
  image = '/og-inference.png',
  title = 'Learning — Chenxi Ma',
  description = 'Necessary concepts, minimal implementations and one-variable experiments connected to real AI systems.',
  ...metadata
} = Astro.props;
---
<SharedLayout title={title} description={description} image={image} {...metadata} siteKind="learning"><slot /></SharedLayout>
