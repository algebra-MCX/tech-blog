---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const entries = await getCollection('guides', ({data}) => !data.draft && data.category === 'quickstarts');
---
<BaseLayout title="Quickstarts — AI Systems Learning Hub" description="Runnable examples with clearly stated assumptions and limitations.">
  <section class="shell hub-hero">
    <p class="eyebrow"><span data-lang="en">Runnable examples</span><span data-lang="zh">可运行的最小实验</span></p>
    <h1><span data-lang="en">Quickstarts</span><span data-lang="zh">最简入门</span></h1>
    <p class="hub-lead"><span data-lang="en">Run a tiny implementation, change one variable, and state what the result does not prove.</span><span data-lang="zh">运行小实现，改变一个变量，再说清楚结果不能证明什么。</span></p>
  </section>
  <section class="shell hub-section"><div class="hub-grid">
    {entries.map(entry => <article class="reading-glass hub-card">
      <h3><a href={'/guides/'+entry.id+'/'}><span data-lang="en">{entry.data.title}</span><span data-lang="zh">{entry.data.titleZh}</span></a></h3>
      <p><span data-lang="en">{entry.data.description}</span><span data-lang="zh">{entry.data.descriptionZh}</span></p>
      <a class="text-link" href={'/guides/'+entry.id+'/'}><span data-lang="en">Try this example →</span><span data-lang="zh">开始实验 →</span></a>
    </article>)}
  </div></section>
</BaseLayout>
