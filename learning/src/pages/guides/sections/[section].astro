---
import {getCollection} from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Localized from '../../../../../src/components/Localized.astro';
export function getStaticPaths(){return ['quickstarts','concepts','playbooks','learning-paths'].map(section=>({params:{section}}));}
const entries=(await getCollection('guides',({data})=>!data.draft)).filter(e=>e.data.category===Astro.params.section);
---
<BaseLayout title="Guides & experiments — Learning"><header class="shell hub-intro"><p class="eyebrow"><Localized en="Available learning materials" zh="已有学习材料"/></p><h1><Localized en="Understand, run, inspect." zh="理解、运行、检查。"/></h1><p><Localized en="Each guide has a concrete question and an explicit limit. Runnable examples require only Python's standard library." zh="每篇都有具体问题与明确边界。可运行示例仅需 Python 标准库。"/></p></header><section class="shell hub-grid">{entries.map(e=><article class="reading-glass hub-card"><h2><a href={e.id === 'how-to-read' ? '/' : `/guides/${e.id}/`}><Localized en={e.data.title} zh={e.data.titleZh}/></a></h2><p><Localized en={e.data.description} zh={e.data.descriptionZh}/></p></article>)}</section></BaseLayout>
