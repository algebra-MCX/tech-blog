---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('guides', ({data}) => !data.draft);
  const translations = await getCollection('guidesZh');
  return entries.map(entry => ({
    params: {id: entry.id},
    props: {entry, translation: translations.find(t => t.data.source === entry.id)}
  }));
}
const {entry, translation} = Astro.props;
const {Content} = await render(entry);
const translated = translation ? await render(translation) : null;
const ContentZh = translated?.Content;
const mainBlog = import.meta.env.PUBLIC_MAIN_BLOG_URL || 'https://tech-blog-chi.vercel.app';
---
<BaseLayout title={entry.data.title+' — AI Systems Learning Hub'} description={entry.data.description}>
  <article class="shell hub-article">
    <header class="hub-article-header reading-glass">
      <nav class="hub-breadcrumb" aria-label="Breadcrumb"><a href="/">Learning Hub</a><span>›</span><a href="/guides/sections/quickstarts/"><span data-lang="en">Guides</span><span data-lang="zh">指南</span></a></nav>
      <h1><span data-lang="en">{entry.data.title}</span><span data-lang="zh">{entry.data.titleZh}</span></h1>
      <p class="hub-description"><span data-lang="en">{entry.data.description}</span><span data-lang="zh">{entry.data.descriptionZh}</span></p>
    </header>
    <div class="hub-body reading-glass">
      <div data-lang="en"><Content /></div>
      {ContentZh ? <div data-lang="zh"><ContentZh /></div> : <p data-lang="zh">中文内容尚未提供，请切换英文。</p>}
    </div>
    <nav class="hub-return" aria-label="Continue reading">
      <a class="text-link" href="/">← <span data-lang="en">Learning Hub</span><span data-lang="zh">学习首页</span></a>
      <a class="text-link" href={mainBlog}><span data-lang="en">Research Blog ↗</span><span data-lang="zh">研究博客 ↗</span></a>
    </nav>
  </article>
</BaseLayout>
